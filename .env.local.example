# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Required for Midtrans webhook to activate premium access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstash Redis rate limiting
# If unset, sensitive routes fail open and continue without rate limiting.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Sentry error monitoring
NEXT_PUBLIC_SENTRY_DSN=https://bd7f3918c1ac71d6d7eb5c865468dc3b@o4511430360301568.ingest.us.sentry.io/4511430574931968
SENTRY_DSN=https://bd7f3918c1ac71d6d7eb5c865468dc3b@o4511430360301568.ingest.us.sentry.io/4511430574931968
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Optional: only needed if you want CI builds to upload source maps.
SENTRY_ORG=farhan-afgany
SENTRY_PROJECT=javascript-nextjs
SENTRY_AUTH_TOKEN=sntrys_your-token

# Product analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
# Also supported if copied from PostHog's wizard:
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Midtrans Snap
MIDTRANS_SERVER_KEY=Mid-server-your-sandbox-server-key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=Mid-client-your-sandbox-client-key
# Keep false while testing sandbox. Change to true only after replacing keys
# with production keys from the Midtrans production dashboard.
MIDTRANS_IS_PRODUCTION=false
# Optional temporary override for small-amount payment testing only.
# Leave empty or remove in production so payments use the regular Rp 149rb price.
PAYMENT_TEST_AMOUNT=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Contact
NEXT_PUBLIC_WHATSAPP_NUMBER=628XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_MESSAGE=Halo admin, saya ingin tanya lebih lanjut tentang BudgetNikah.
